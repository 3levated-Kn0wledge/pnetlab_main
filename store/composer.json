{
    "name": "pnetlab/pnetlab",
    "description": "PNETLab \u2014 network emulation lab platform",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "BSD-3-Clause",
    "type": "project",
    "require": {
        "firebase/php-jwt": "^6.10",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.9",
        "laravel/ui": "^4.6",
        "php": "^8.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "files": [
            "app/Helpers/Default.php"
        ],
        "classmap": [
            "database/seeds",
            "database/factories"
        ],
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    }
}
