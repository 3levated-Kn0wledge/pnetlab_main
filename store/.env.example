# Template for store/.env. Copied into place by install/lib/store.sh when the
# deployment has none; the installer then generates a per-installation APP_KEY
# and forces production values.
#
# The real store/.env was tracked in this repository until this file replaced
# it, complete with a live APP_KEY, APP_DEBUG=true and APP_LOG_LEVEL=debug.
# .gitignore listed .env from the beginning, which does nothing for a file that
# is already tracked. That key must be treated as burned: it is in this
# repository history and in upstream's.
#
# APP_KEY is deliberately empty here. install/lib/store.sh fills it, and
# tests/Security/EnvNotTrackedTest.php fails if a value ever appears in it.

APP_NAME=null
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_LOG_LEVEL=warning
APP_URL=http://localhost

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_DRIVER=sync 

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
