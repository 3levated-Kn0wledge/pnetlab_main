			// not know how this application stores its sessions. Any failure
			// returns null and the action refuses — see its restore().
			'sessions' => function () {
				try {
					$db = checkDatabase();
					if (!$db) return null;
					$labs  = $db->query('SELECT COUNT(*) FROM ' . LAB_SESSIONS_TABLE);
					$nodes = $db->query('SELECT COUNT(*) FROM ' . NODE_SESSIONS_TABLE);
					if ($labs === false || $nodes === false) return null;
					return array('labs'  => (int) $labs->fetchColumn(),
					             'nodes' => (int) $nodes->fetchColumn());
