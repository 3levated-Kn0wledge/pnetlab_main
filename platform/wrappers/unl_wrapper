		// password. Both schemas are dumped to temporary files and renamed into
		// place only if BOTH succeeded, so a half-finished backup cannot present
		// itself as a whole one.
		require_once(__DIR__ . '/actions/UnlBackupDatabase.php');

		$backupDb = new UnlBackupDatabase();
		$backupResult = $backupDb->backup();
		echo 'BACKUPDB-RESULT ' . json_encode($backupResult) . "\n";
		if (!$backupResult['ok']) {
			error_log(date('M d H:i:s ') . 'ERROR: backupdb: ' . $backupResult['error']);
			exit(48);
