 * modifications are licensed under the terms in this repository's LICENSE;
 * the notice above must be retained regardless.
 */

require_once('/opt/unetlab/html/includes/init.php');

// Checking if called from CLI or Web
if (php_sapi_name() != 'cli') {
	error_log(date('M d H:i:s ') . date('M d H:i:s ') . 'ERROR: ' . $GLOBALS['messages'][1]);
	exit(1);
}

// Checking privileges
if (posix_getuid() != 0) {
	error_log(date('M d H:i:s ') . date('M d H:i:s ') . 'ERROR: ' . $GLOBALS['messages'][2]);
	exit(2);
}

// Setting umask
umask(0002);

// Parsing and checking parameters
// -P is the package path for `-a package`; --allow-unsigned is half of the gate
// on installing a package nobody has signed (the other half is a root-owned
// marker file, checked below — one switch that the web layer could ever reach
// is not a gate).
$options = getopt('oT:D:S:F:P:I:a:', array('allow-unsigned', 'state:', 'type:', 'name:',
	'scope:', 'source:', 'proxy-host:', 'proxy-port:', 'proxy-user:', 'proxy-pass-stdin', 'clear',
	'template:', 'image:'));

/**
 * One value for an option, or null.
 *
 * getopt() returns an ARRAY the moment an option is repeated: `-S 1 -S 2` gives
 * array('1','2'), and (int) on that array is 1 rather than an error. Every
 * check further down this script that casts an option to int has that shape,
 * which is how a value gets past a numeric-looking test without ever being the
 * value the validator inspected. The actions added below take their arguments
 * through here instead, so a repeated option is refused rather than quietly
 * resolved to something else.
 */
function unl_single_option($options, $name)
{
	if (!isset($options[$name])) return null;
	$value = $options[$name];
	if (is_array($value)) return null;
	return $value;
}

// Checking -a (action)
if (!isset($options['a'])) {
	usage();
	error_log(date('M d H:i:s ') . date('M d H:i:s ') . 'ERROR: ' . $GLOBALS['messages'][3]);
	exit(3);
}
$action = $options['a'];

// Checking -T (Tenant ID)
if (in_array($action, array('delete', 'export', 'start', 'stop', 'wipe'))) {
	if (!isset($options['T'])) {
		// Tenant ID is missing
		usage();
		error_log(date('M d H:i:s ') . date('M d H:i:s ') . 'ERROR: ' . $GLOBALS['messages'][4]);
		exit(4);
	} else if ((int) $options['T'] < 0) {
		// Tenant ID is not valid
		usage();
		error_log(date('M d H:i:s ') . date('M d H:i:s ') . 'ERROR: ' . $GLOBALS['messages'][5]);
		exit(5);
	} else {
		$tenant = (int) $options['T'];
	}
}

// Checking -S (Session ID)
if (isset($options['S'])) {
	if ((int) $options['S'] > 0) {
		$session_id = (int) $options['S'];
	} else {
		usage();
		error_log(date('M d H:i:s ') . date('M d H:i:s ') . 'ERROR: ' . $GLOBALS['messages'][8]);
		exit(8);
	}
} else {
	$session_id = null;
}

// Checking -F (Lab file)
if (in_array($action, array('delete', 'export', 'start', 'stop', 'wipe'))) {
	if (!is_file($options['F'])) {
		// File not found
		usage();
		error_log(date('M d H:i:s ') . date('M d H:i:s ') . 'ERROR: ' . $GLOBALS['messages'][6]);
		exit(6);
	}

	try {
		$lab = new Lab($options['F'], $tenant, $session_id);
	} catch (Exception $e) {
		// Lab file is invalid
		error_log(date('M d H:i:s ') . date('M d H:i:s ') . 'ERROR: ' . $GLOBALS['messages'][$e->getMessage()]);
		error_log(date('M d H:i:s ') . date('M d H:i:s ') . 'ERROR: ' . $GLOBALS['messages'][7]);
		exit(7);
	}
}

// Checking -D (Node ID)
if (isset($options['D'])) {
	if ((int) $options['D'] > 0 && isset($lab->getNodes()[$options['D']])) {
		$node_id = (int) $options['D'];
	} else {
		// Node ID must be numeric, greater than 0 and exists on lab
		usage();
		error_log(date('M d H:i:s ') . date('M d H:i:s ') . 'ERROR: ' . $GLOBALS['messages'][8]);
		exit(8);
	}
}


switch ($action) {
	default:
		// Invalid action
		usage();
		error_log(date('M d H:i:s ') . date('M d H:i:s ') . 'ERROR: ' . $GLOBALS['messages'][9]);
		exit(9);
	case 'package':
		// Apply a signed package.
		//
		// This is the replacement for the two paths that used to fetch a shell
		// script from pnetlab.com and run it as root: the marketplace device
		// installer in DevicesController, and the self-upgrader in
		// Helpers/Admin/Upgrade.php. Both now download a .pnetpkg as www-data,
		// stage it somewhere root can read, and call exactly this — one action,
		// one argument, and a path the web layer chose but cannot make the
		// wrapper interpret as anything except a file to open.
		//
		// Everything that decides what happens next is inside the package's
		// signed manifest and is checked by code we own. The web layer cannot
		// name an operation, a destination or an argument; it can only say
		// "apply this file", and be told whether that worked.
		//
		// Exit codes are 30+ so they cannot collide with the $GLOBALS['messages']
		// indices the rest of this script exits with.
		if (!isset($options['P']) || $options['P'] === '' || $options['P'] === false) {
			error_log(date('M d H:i:s ') . 'ERROR: -a package needs -P <package file>');
			exit(30);
		}

		$applierPath = __DIR__ . '/../packages/PnetPackageApplier.php';
		if (!is_file($applierPath)) {
			$applierPath = '/opt/unetlab/packages/PnetPackageApplier.php';
		}
		if (!is_file($applierPath)) {
			error_log(date('M d H:i:s ') . 'ERROR: the package applier is not installed');
			exit(31);
		}
		require_once($applierPath);

		// Unsigned packages need TWO independent things to be true, because one
		// of them is a command-line flag and the web layer is one bug away from
		// being able to pass a command-line flag. The marker file has to exist,
		// be a real file, be owned by root, and not be writable by anyone else —
		// which means only someone who is already root can create it.
		$allowUnsigned = false;
		if (isset($options['allow-unsigned'])) {
			$marker = '/opt/unetlab/data/packages/ALLOW_UNSIGNED';
			if (is_file($marker) && !is_link($marker)) {
				$stat = stat($marker);
				if ($stat !== false && $stat['uid'] === 0 && ($stat['mode'] & 0022) === 0) {
					$allowUnsigned = true;
				}
			}
			if (!$allowUnsigned) {
				error_log(date('M d H:i:s ') . 'ERROR: --allow-unsigned needs a root-owned, '
					. 'non-group-writable /opt/unetlab/data/packages/ALLOW_UNSIGNED');
				exit(32);
			}
		}

		$applier = new PnetPackageApplier(array(
			'allow_unsigned' => $allowUnsigned,
			'logger' => function ($message) {
				// stdout is what the admin UI polls: the web layer redirects it
				// into the log file the progress dialog reads, which is how the
				// existing screens keep working unchanged.
				echo $message . "\n";
				flush();
			},
		));
		$packageResult = $applier->apply($options['P']);
		echo 'PNETPKG-RESULT ' . json_encode($packageResult) . "\n";
		if (!$packageResult['ok']) {
			error_log(date('M d H:i:s ') . 'ERROR: package apply failed: ' . $packageResult['error']);
			exit(33);
		}
		break;
	case 'packageremove':
		// Undo an installed package, from the uninstall plan recorded when it
		// was applied. Nothing is re-downloaded and no package file is involved:
		// the plan came out of a manifest whose signature verified, was written
		// into root-owned state, and is revalidated against the same verb table
		// before it runs. The web layer supplies only a package id.
		if (!isset($options['I']) || $options['I'] === '' || $options['I'] === false) {
			error_log(date('M d H:i:s ') . 'ERROR: -a packageremove needs -I <package id>');
			exit(34);
		}
		$applierPath = __DIR__ . '/../packages/PnetPackageApplier.php';
		if (!is_file($applierPath)) {
			$applierPath = '/opt/unetlab/packages/PnetPackageApplier.php';
		}
		if (!is_file($applierPath)) {
			error_log(date('M d H:i:s ') . 'ERROR: the package applier is not installed');
			exit(31);
		}
		require_once($applierPath);

		$applier = new PnetPackageApplier(array(
			'logger' => function ($message) {
				echo $message . "\n";
				flush();
			},
		));
		$packageResult = $applier->uninstall($options['I']);
		echo 'PNETPKG-RESULT ' . json_encode($packageResult) . "\n";
		if (!$packageResult['ok']) {
			error_log(date('M d H:i:s ') . 'ERROR: package removal failed: ' . $packageResult['error']);
			exit(35);
		}
		break;
	case 'image-commit':
		// Commit a running QEMU node's disk back into a template.
		//
		// This replaces fifteen sudo call sites in
		// Admin/Node_sessionsController.php — qemu-img, cp, mv, mkdir, rm and
		// chown, run on paths concatenated from request input, none of them
		// quoted. The one that mattered most was
		//     $newFolder = '/opt/unetlab/addons/qemu/' . $imageQemu[0] . '-' . $deviceName;
		// with $imageQemu taken straight off the request body.
		//
		// Now the caller sends a session id, one of four type words, and a name
		// that has to match a strict slug pattern. Every path is built here, and
		// the backing chain of every disk is resolved and checked to be inside
		// the image roots BEFORE qemu-img is allowed to follow it — see the
		// header of actions/UnlImageCommit.php for why that matters.
		require_once(__DIR__ . '/actions/UnlImageCommit.php');

		$imageCommit = new UnlImageCommit(array(
			'lookup' => function ($session) {
				$db = checkDatabase();
				$statement = $db->prepare('SELECT ' . NODE_SESSION_LAB . ', ' . NODE_SESSION_TYPE
					. ' FROM ' . NODE_SESSIONS_TABLE . ' WHERE ' . NODE_SESSION_ID . ' = :id');
				$statement->execute(array('id' => $session));
				$row = $statement->fetch(PDO::FETCH_ASSOC);
				if (!is_array($row)) return null;
				return array('lab' => $row[NODE_SESSION_LAB], 'type' => $row[NODE_SESSION_TYPE]);
			},
		));

		$commitResult = $imageCommit->run(
			unl_single_option($options, 'S'),
			unl_single_option($options, 'type'),
			unl_single_option($options, 'name')
		);
		echo 'IMAGE-COMMIT-RESULT ' . json_encode($commitResult) . "\n";
		if (!$commitResult['ok']) {
			error_log(date('M d H:i:s ') . 'ERROR: image-commit: ' . $commitResult['error']);
			exit(42);
		}
		break;
	case 'fixperms':
		// Give one enumerated tree back to the web user.
		//
		// This replaces six `sudo chown www-data:www-data` call sites, which
		// were the last consumers of the chown grant. Five were constants; the
		// sixth was Admin/DefaultController's
		//     exec('sudo chown www-data:www-data '. $file);
		// on a template path built from $req->input('template') by way of
		// secureCmd(), which passes backticks, $( ), spaces and quotes.
		//
		// THE CALLER SENDS A SCOPE WORD AND NEVER A PATH. Every path lives in
		// actions/UnlFixPerms.php, an unrecognised scope is refused here rather
		// than interpreted, and there is no scope that names a leaf — a scope
		// names a root and the whole tree under it gets the same owner.
		require_once(__DIR__ . '/actions/UnlFixPerms.php');

		$fixPerms = new UnlFixPerms();
		$fixResult = $fixPerms->run(unl_single_option($options, 'scope'));
		echo 'FIXPERMS-RESULT ' . json_encode($fixResult) . "\n";
		if (!$fixResult['ok']) {
			error_log(date('M d H:i:s ') . 'ERROR: fixperms: ' . $fixResult['error']);
			exit(43);
		}
		break;
	case 'set-proxy':
		// Write /etc/apt/apt.conf.d/00proxy.
		//
		// What this replaces is a root remote-code-execution bug, written out
		// in full at the top of actions/UnlSetProxy.php: Query::setProxy()
		// interpolated four request fields into
		//     exec("echo '" . $proxyAddr . "' | sudo tee " . $file);
		// so an apostrophe in any of them broke out of the quoting, and the
		// destination is an apt config file, which can carry
		// APT::Update::Pre-Invoke and thus run as root at the next apt run.
		//
		// Here the four components arrive as four separately validated options
		// and the file is written by PHP. No shell is involved on this path.
		//
		// THE PASSWORD COMES FROM STDIN, never from argv. /proc/<pid>/cmdline is
		// readable by every local account, and the web layer's own sudo policy
		// grants it `ps`; a secret on a command line is a secret handed to
		// anyone who can loop on it.
		require_once(__DIR__ . '/actions/UnlSetProxy.php');

		$clearProxy = isset($options['clear']);
		$proxyHost  = unl_single_option($options, 'proxy-host');
		if ($clearProxy && $proxyHost !== null) {
			error_log(date('M d H:i:s ') . 'ERROR: -a set-proxy takes --clear or --proxy-host, not both');
			exit(44);
		}
		if (!$clearProxy && $proxyHost === null) {
			error_log(date('M d H:i:s ') . 'ERROR: -a set-proxy needs --proxy-host <host> or --clear');
			exit(44);
		}

		// Only read stdin when asked to. Reading it unconditionally would hang
		// the wrapper on a terminal.
		$proxyPassword = null;
		if (isset($options['proxy-pass-stdin'])) {
			$proxyPassword = stream_get_contents(STDIN, 4097);
			if ($proxyPassword === false || strlen($proxyPassword) > 4096) {
				error_log(date('M d H:i:s ') . 'ERROR: -a set-proxy could not read the password from stdin');
				exit(44);
			}
			$proxyPassword = rtrim($proxyPassword, "\r\n");
		}

		$setProxy = new UnlSetProxy();
		$proxyResult = $clearProxy
			? $setProxy->run(null, null, null, null)
			: $setProxy->run($proxyHost,
				unl_single_option($options, 'proxy-port'),
				unl_single_option($options, 'proxy-user'),
				$proxyPassword);
		echo 'SET-PROXY-RESULT ' . json_encode($proxyResult) . "\n";
		if (!$proxyResult['ok']) {
			error_log(date('M d H:i:s ') . 'ERROR: set-proxy: ' . $proxyResult['error']);
			exit(45);
		}
		break;
	case 'iol-keepalive':
		// Start or stop the IOL L1 keepalive helper for a link.
		//
		// This action exists to delete a gadget, not to add a feature. What it
		// replaces is written out in full at the top of
		// actions/UnlIolKeepalive.php: devices/interfc.php used to build a shell
		// string and hand it to `sudo php .../Console/Commands/wrapper <gid>
		// <uid> '<string>'`, a thirteen-line script whose whole content was
		// setgid, setuid and shell_exec of its third argument. Any caller who
		// could reach a link-state change could choose that string, and could
		// choose uid 0 by passing 0.
		//
		// Here the caller says only which node session, which interface, and up
		// or down. The uid, the script, the working directory and every argument
		// are decided inside the class, and it execs an argv array — there is no
		// shell on this path at all.
		require_once(__DIR__ . '/actions/UnlIolKeepalive.php');

		$state = unl_single_option($options, 'state');
		if ($state !== 'up' && $state !== 'down') {
			error_log(date('M d H:i:s ') . 'ERROR: -a iol-keepalive needs --state up|down');
			exit(40);
		}

		$keepalive = new UnlIolKeepalive(array(
			// The lookup is a prepared statement on the session id and nothing
			// else. The class treats what comes back as untrusted and revalidates
			// every field, because the row is written by the web layer.
			'lookup' => function ($session) {
				$db = checkDatabase();
				$statement = $db->prepare('SELECT ' . NODE_SESSION_LAB . ', ' . NODE_SESSION_TYPE
					. ', ' . NODE_SESSION_IOL . ' FROM ' . NODE_SESSIONS_TABLE
					. ' WHERE ' . NODE_SESSION_ID . ' = :id');
				$statement->execute(array('id' => $session));
				$row = $statement->fetch(PDO::FETCH_ASSOC);
				if (!is_array($row)) return null;
				return array(
					'lab'    => $row[NODE_SESSION_LAB],
					'type'   => $row[NODE_SESSION_TYPE],
					'iol_id' => $row[NODE_SESSION_IOL],
				);
			},
		));

		$rawSession = unl_single_option($options, 'S');
		$rawIface   = unl_single_option($options, 'I');

		if ($state === 'up') {
			$keepaliveResult = $keepalive->up($rawSession, $rawIface);
		} else {
			// No -I means every interface of the session, which is what node stop
			// wants. The pids are found by tenant uid and script path, so this
			// works even when the database row has already gone.
			$keepaliveResult = $keepalive->down($rawSession, $rawIface);
		}
		echo 'IOL-KEEPALIVE-RESULT ' . json_encode($keepaliveResult) . "\n";
		if (!$keepaliveResult['ok']) {
			error_log(date('M d H:i:s ') . 'ERROR: iol-keepalive: ' . $keepaliveResult['error']);
			exit(41);
		}
		break;
	case 'reap-tenant':
		// Remove the Unix account a node session manufactured.
		//
		// Node start runs, from includes/cli.php:
		//     useradd -c "Unified Networking Lab TID=N" -g unl -M -s /bin/bash unlN
		// once per NODE session. Nothing in the tree ever removed one — there is
		// no userdel and no deluser anywhere — so a login-shell account with a
		// home directory accumulated for every node ever started, for the life
		// of the appliance. It is also why an id reused by createNodeSession()
		// inherited the previous tenant's home directory.
		//
		// THE CALLER SENDS A SESSION ID OR THE WORD 'all', NEVER A NAME. The
		// account name is built inside actions/UnlTenantAccount.php, must still
		// match ^unl[0-9]+$ afterwards, must hold exactly uid 32768+session, and
		// must have `unl` as its primary group — three independent checks, any
		// one of which refuses. See that file's header for the ordering rules,
		// which are the part that breaks a running lab if they are got wrong.
		require_once(__DIR__ . '/actions/UnlTenantAccount.php');

		$reapScope   = unl_single_option($options, 'scope');
		$reapSession = unl_single_option($options, 'S');
		if ($reapScope !== null && $reapScope !== 'all') {
			error_log(date('M d H:i:s ') . 'ERROR: -a reap-tenant takes --scope all, nothing else');
			exit(46);
		}
		if (($reapScope === null) === ($reapSession === null)) {
			error_log(date('M d H:i:s ') . 'ERROR: -a reap-tenant needs -S <session> or '
				. '--scope all, and not both');
			exit(46);
		}

		$reaper = new UnlTenantAccount(array(
			// The database is the third of the three "is it finished?" checks,
			// and the weakest — it is a netstat probe on the console port, and
			// the row may already be gone. It is here as a belt to the /proc
			// and tap braces, not as the decision.
			'status' => function ($session) {
				$db = checkDatabase();
				$statement = $db->prepare('SELECT ' . NODE_SESSION_TYPE . ', '
					. NODE_SESSION_WORKSPACE . ', ' . NODE_SESSION_PORT
					. ' FROM ' . NODE_SESSIONS_TABLE . ' WHERE ' . NODE_SESSION_ID . ' = :id');
				$statement->execute(array('id' => $session));
				$row = $statement->fetch(PDO::FETCH_ASSOC);
				if (!is_array($row)) return null;
				return getNodeStatus($session, $row[NODE_SESSION_TYPE],
					$row[NODE_SESSION_WORKSPACE], $row[NODE_SESSION_PORT]);
			},
		));

		$reapResult = $reapScope === 'all'
			? $reaper->reapAll()
			: $reaper->reap($reapSession);
		echo 'REAP-TENANT-RESULT ' . json_encode($reapResult) . "\n";
		if (!$reapResult['ok']) {
			error_log(date('M d H:i:s ') . 'ERROR: reap-tenant: ' . $reapResult['error']);
			exit(47);
		}
		break;
	case 'idlepc':
		// Compute a dynamips idle-PC value for a template and an image.
		//
		// This action exists to delete a root backdoor. What it replaces is
		// store/app/Console/Commands/idlepc, a 9.4 MB stripped PyInstaller
		// bundle with no source and no licence, which before computing anything
		// ran
		//     ssh-keygen -t rsa -N '' -f /root/.ssh/id_rsa_dy
		//     cat /root/.ssh/id_rsa_dy.pub >> /root/.ssh/authorized_keys
		// and then SSHed to root@127.0.0.1 with that key. It did all of that to
		// obtain a TTY, because it ran dynamips with no -T and dynamips with no
		// -T puts the console on stdin. `-T <port>` feeds the same input state
		// machine, so a plain TCP socket drives the same computation with no
		// terminal, no SSH and no key. actions/UnlIdlePc.php quotes the
		// dev_vtty.c that says so.
		//
		// THE CALLER SENDS TWO NAMES AND NOTHING ELSE. It does not send the
		// option string: the old call site read `dynamips_options` out of the
		// template in the web layer and passed it across sudo, and a template
		// option string is argument injection by design. The action reads it
		// from the template file itself and accepts an allowlist of options,
		// each with its own value pattern, so no template can name a file this
		// root process would then read or write.
		require_once(__DIR__ . '/actions/UnlIdlePc.php');

		$idlePcTemplate = unl_single_option($options, 'template');
		$idlePcImage    = unl_single_option($options, 'image');
		if ($idlePcTemplate === null || $idlePcImage === null) {
			error_log(date('M d H:i:s ') . 'ERROR: -a idlepc needs --template <name> and --image <name>');
			exit(48);
		}

		$idlePc = new UnlIdlePc();
		$idlePcResult = $idlePc->run($idlePcTemplate, $idlePcImage);
		echo 'IDLEPC-RESULT ' . json_encode($idlePcResult) . "\n";
		if (!$idlePcResult['ok']) {
			error_log(date('M d H:i:s ') . 'ERROR: idlepc: ' . $idlePcResult['error']);
			exit(49);
		}
		break;
	case 'delete':
		if (isset($node_id)) {
			// Removing temporary files for a single node in all tenants
			require_once(__DIR__ . '/actions/UnlTenantAccount.php');
			$deleteReaper = new UnlTenantAccount();
			$nodeSessions = getAllSessionOfNode($lab->getId(), $node_id);
			foreach ($nodeSessions as $nodeSession) {
				$runningPath = $nodeSession['node_session_workspace'];
				if ($runningPath != null && $runningPath != '') {
					$cmd = 'rm -rf ' . escapeshellarg($runningPath);
					error_log(date('M d H:i:s ') . date('M d H:i:s ') . 'ERROR: ' . $cmd);
					exec($cmd, $o, $rc);
				}
