		break;
	case 'stop':
		// Stopping node(s)
		if (isset($node_id)) {
			$result = stop($lab->getNodes()[$node_id]);
			if ($result != 0) exit($result);
		
		} else {
			foreach ($lab->getNodes() as $node) {
				$result = stop($node); 
