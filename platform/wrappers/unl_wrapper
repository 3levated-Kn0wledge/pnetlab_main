		// running emulators — which leaves taps and tenant accounts that nothing
		// can find to reap. It also takes a safety dump of the current databases
		// into <backup root>/pre-restore/ first, and will not proceed if that
		// dump fails.
		require_once(__DIR__ . '/actions/UnlBackupDatabase.php');

		$restoreDb = new UnlBackupDatabase(array(
