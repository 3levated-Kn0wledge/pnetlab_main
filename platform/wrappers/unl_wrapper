	case 'stopall':
		// Kill all nodes and clear the system
		$cmd = 'pkill -TERM dynamips > /dev/null 2>&1';
		exec($cmd, $o, $rc);
		$cmd = 'pkill -TERM iol_wrapper > /dev/null 2>&1';
		exec($cmd, $o, $rc);
		$cmd = 'pkill -TERM qemu* > /dev/null 2>&1';
		exec($cmd, $o, $rc);
		$cmd = 'pkill -TERM vpcs > /dev/null 2>&1';
		exec($cmd, $o, $rc);
		$cmd = 'docker -H=tcp://127.0.0.1:4243 stop $(docker -H=tcp://127.0.0.1:4243 ps -q)';
		exec($cmd, $o, $rc);
		$cmd = 'brctl show | grep vnet | sed \'s/^\(vnet[0-9]\+_[0-9]\+\).*/\1/g\' | while read line; do ifconfig $line down; brctl delbr $line; done';
		exec($cmd, $o, $rc);
		$cmd = 'brctl show | grep internal | sed \'s/^\(internal[0-9]\+_[0-9]\+\).*/\1/g\' | while read line; do ifconfig $line down; brctl delbr $line; done';
        exec($cmd, $o, $rc);
        $cmd = 'brctl show | grep private | sed \'s/^\(private[0-9]\+_[0-9]\+\).*/\1/g\' | while read line; do ifconfig $line down; brctl delbr $line; done';
        exec($cmd, $o, $rc);
		$cmd = 'ovs-vsctl list-br | while read line; do ovs-vsctl del-br $line; done';
		exec($cmd, $o, $rc);
		// `ifconfig` with no arguments lists only interfaces that are UP, so this
		// used to walk past every tap belonging to a node that had already been
		// killed — which is all of them, by this point in stopall. The taps
		// survived the action whose entire job is to clear the system, and with
		// the tenant reaper below they would also pin the accounts that own
		// them, because a surviving vunl<N>_* is a refusal to reap. `ip -o link
		// show` lists every interface regardless of state.
		$cmd = 'ip -o link show | grep -o \'vunl[0-9]\+_[0-9]\+\' | sort -u'
			. ' | while read line; do ip link set $line down; tunctl -d $line; done';
		exec($cmd, $o, $rc);
		$cmd = 'find /opt/unetlab/labs/ -name "*.lock" -exec rm -f {} \;';
		exec($cmd, $o, $rc);

		// Every node is dead and every tap is gone, so every tenant account is
		// finished by definition. This is also the net under node stop: a stop
